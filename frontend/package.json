{
  "name": "wallet-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "dev:wails": "vite --host 127.0.0.1 --mode wails"
  },
  "dependencies": {
    "pinia": "3.0.4",
    "qrcode": "1.5.4",
    "vue": "3.5.45",
    "vue-i18n": "11.4.21",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/qrcode": "1.5.5",
    "@vitejs/plugin-vue": "6.0.2",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.5.1",
    "jsdom": "27.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "vue-tsc": "3.1.3"
  }
}
